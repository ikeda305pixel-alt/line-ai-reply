<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/bottomBarRoot"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_bar"
    android:elevation="10dp"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="6dp"
    android:paddingVertical="3dp">

    <!-- Drag Handle / Indicator -->
    <TextView
        android:id="@+id/btnBottomBarDrag"
        android:layout_width="20dp"
        android:layout_height="32dp"
        android:gravity="center"
        android:text="⋮⋮"
        android:textColor="#94A3B8"
        android:textSize="14sp" />

    <!-- AI Tag -->
    <TextView
        android:id="@+id/textBarTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="4dp"
        android:text="AI"
        android:textStyle="bold"
        android:textColor="#059669"
        android:textSize="11sp" />

    <!-- Action Buttons Container (Collapsible) -->
    <LinearLayout
        android:id="@+id/layoutBarActions"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- 1. 返信提案 -->
        <Button
            android:id="@+id/btnBarReply"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_marginEnd="3dp"
            android:background="@drawable/bg_overlay_btn"
            android:backgroundTint="@color/line_green"
            android:paddingHorizontal="8dp"
            android:text="💬 返信"
            android:textColor="@color/white"
            android:textSize="11sp" />

        <!-- 2. 日程調整 -->
        <Button
            android:id="@+id/btnBarSchedule"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_marginEnd="3dp"
            android:background="@drawable/bg_overlay_btn"
            android:backgroundTint="#0EA5E9"
            android:paddingHorizontal="8dp"
            android:text="📅 日程"
            android:textColor="@color/white"
            android:textSize="11sp" />

        <!-- 3. 話題提案 -->
        <Button
            android:id="@+id/btnBarTopic"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_marginEnd="3dp"
            android:background="@drawable/bg_overlay_btn"
            android:backgroundTint="#F59E0B"
            android:paddingHorizontal="8dp"
            android:text="💡 話題"
            android:textColor="@color/white"
            android:textSize="11sp" />

        <!-- 4. ムード分析 -->
        <Button
            android:id="@+id/btnBarMood"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_marginEnd="4dp"
            android:background="@drawable/bg_overlay_btn"
            android:backgroundTint="#8B5CF6"
            android:paddingHorizontal="8dp"
            android:text="🔍 分析"
            android:textColor="@color/white"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- Minimize / Expand Toggle -->
    <TextView
        android:id="@+id/btnBarMinimize"
        android:layout_width="22dp"
        android:layout_height="32dp"
        android:gravity="center"
        android:text="◀"
        android:textColor="#64748B"
        android:textSize="11sp" />

    <!-- Close button -->
    <TextView
        android:id="@+id/btnBarClose"
        android:layout_width="22dp"
        android:layout_height="32dp"
        android:gravity="center"
        android:text="✕"
        android:textColor="#94A3B8"
        android:textSize="13sp" />

</LinearLayout>
