<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/cardRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_reply_sheet"
    android:elevation="12dp"
    android:orientation="vertical"
    android:padding="12dp">

    <!-- Header: Platform Tag, Summary, and Close Button -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/textPlatformTag"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_line_pill"
            android:paddingHorizontal="8dp"
            android:paddingVertical="3dp"
            android:text="LINE AI"
            android:textColor="@color/white"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/textContextSummary"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="AI解析準備完了"
            android:textColor="@color/text_secondary"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/btnClose"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:gravity="center"
            android:text="✕"
            android:textColor="@color/text_secondary"
            android:textSize="16sp" />
    </LinearLayout>

    <!-- 4 Mode Action Selector Bar (返信提案 / 日程調整 / 話題提案 / ムード分析) -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnModeReply"
                style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:layout_marginEnd="4dp"
                android:backgroundTint="@color/line_green"
                android:paddingHorizontal="10dp"
                android:text="💬 返信提案"
                android:textColor="@color/white"
                android:textSize="11sp" />

            <Button
                android:id="@+id/btnModeSchedule"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:layout_marginEnd="4dp"
                android:paddingHorizontal="10dp"
                android:text="📅 日程調整"
                android:textColor="@color/text_primary"
                android:textSize="11sp" />

            <Button
                android:id="@+id/btnModeTopic"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:layout_marginEnd="4dp"
                android:paddingHorizontal="10dp"
                android:text="💡 話題提案"
                android:textColor="@color/text_primary"
                android:textSize="11sp" />

            <Button
                android:id="@+id/btnModeMood"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:paddingHorizontal="10dp"
                android:text="🔍 ムード分析"
                android:textColor="@color/text_primary"
                android:textSize="11sp" />
        </LinearLayout>
    </HorizontalScrollView>

    <!-- Screenshot Priority Banner -->
    <TextView
        android:id="@+id/textScreenshotPreview"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="#ECFDF5"
        android:paddingHorizontal="10dp"
        android:paddingVertical="4dp"
        android:ellipsize="end"
        android:maxLines="2"
        android:text="📸 直近スクショを反映中"
        android:textColor="#047857"
        android:textSize="11sp"
        android:visibility="gone" />

    <!-- Clipboard Text Priority Banner -->
    <TextView
        android:id="@+id/textClipboardPreview"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="#FEF3C7"
        android:paddingHorizontal="10dp"
        android:paddingVertical="4dp"
        android:ellipsize="end"
        android:maxLines="2"
        android:text="📋 コピー文を反映中"
        android:textColor="#92400E"
        android:textSize="11sp"
        android:visibility="gone" />

    <!-- Mini Input Layout (Visible when neither screenshot nor clipboard is available, or user taps 手動入力) -->
    <LinearLayout
        android:id="@+id/layoutMiniInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="#F1F5F9"
        android:orientation="vertical"
        android:padding="8dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/textMiniInputGuide"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="💡 LINEでスクショ（電源＋音量下）を撮るか、メッセージをコピーすると自動解析されます。\nここに一言メモを入力して直接AI生成も可能です："
            android:textColor="#475569"
            android:textSize="11sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/editMiniPrompt"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="1"
                android:background="@android:drawable/edit_text"
                android:hint="例: 明日の予定 / カフェお誘い"
                android:imeOptions="actionDone"
                android:inputType="text"
                android:paddingHorizontal="8dp"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnMiniGenerate"
                style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:layout_marginStart="6dp"
                android:backgroundTint="@color/line_green"
                android:text="🚀 AI生成"
                android:textColor="@color/white"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- 4 Selectable Reply Options -->
    <LinearLayout
        android:id="@+id/optionsLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="vertical">

        <Button
            android:id="@+id/btnOpt1"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:gravity="start|center_vertical"
            android:paddingVertical="6dp"
            android:text="😊 案1"
            android:textAllCaps="false"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btnOpt2"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:gravity="start|center_vertical"
            android:paddingVertical="6dp"
            android:text="✨ 案2"
            android:textAllCaps="false"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btnOpt3"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:gravity="start|center_vertical"
            android:paddingVertical="6dp"
            android:text="😄 案3"
            android:textAllCaps="false"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btnOpt4"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:gravity="start|center_vertical"
            android:paddingVertical="6dp"
            android:text="☕ 案4"
            android:textAllCaps="false"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Bottom Actions -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingTop="4dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="タップでクリップボードに自動コピー"
            android:textColor="@color/text_secondary"
            android:textSize="11sp" />

        <Button
            android:id="@+id/btnRegenerate"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="0dp"
            android:paddingHorizontal="10dp"
            android:text="🔄 別の案"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btnDirectType"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="0dp"
            android:paddingHorizontal="10dp"
            android:text="✍️ メモ入力"
            android:textColor="@color/line_green_dark"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
